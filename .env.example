# Kopier til .env og fyll inn. .env skal ALDRI sjekkes inn (se .gitignore).
#
# GRATISPRINSIPP: Dette skal kunne gjennomføres uten at noen i gruppen
# bruker egne penger. Velg en leverandør med reell gratis-tilgang (ingen
# kredittkort). En betalt modell er valgfritt tillegg i eksperimentdelen
# (Del B) - aldri en forutsetning. Gratisnivåer endrer seg over tid - sjekk
# gjeldende vilkår hos leverandøren.
#
# Kjente gratis-alternativer:
#   - Groq (https://console.groq.com/keys): gratis kvote uten kredittkort,
#     OpenAI-kompatibelt. Dette bruker vi. Modeller med verktøystøtte på
#     gratisnivået (sjekket 20.09.2026): openai/gpt-oss-20b,
#     openai/gpt-oss-120b og qwen/qwen3.8-27b. Grenser per modell:
#     30 forespørsler/min, 1000/dag, 8000 tokens/min, 200 000 tokens/dag.
#   - OpenRouter (https://openrouter.ai/keys): velg en modell merket
#     ":free". Maks 50 forespørsler per dag uten kjøpt kreditt.
#   - Google AI Studio / Gemini (https://aistudio.google.com/apikey):
#     gratis kvote, OpenAI-kompatibelt endepunkt.
#   - OpenAI direkte (https://platform.openai.com/api-keys) er IKKE gratis -
#     bruk kun hvis gruppen bevisst velger å betale selv (f.eks. for Del B).
API_KEY=lim-inn-nøkkelen-her

# Modellnavn slik leverandøren forventer det.
MODEL_NAME=qwen/qwen3.8-27b:free
# Andre eksempler:
#   openai/gpt-oss-20b                     (mindre modell, samme leverandør)
#   deepseek/deepseek-chat-v3.1:free       (OpenRouter)
#   gemini-2.5-flash                       (Google AI Studio)

# Base-URL for API-et. Eksempler:
#   https://api.groq.com/openai/v1                           (Groq)
#   https://openrouter.ai/api/v1                             (OpenRouter)
#   https://generativelanguage.googleapis.com/v1beta/openai/ (Google AI Studio)
#   https://api.openai.com/v1                                (OpenAI, betalt)
API_BASE_URL=https://api.groq.com/openai/v1

# --- Innstillinger vi har lagt til -------------------------------------------

# Temperatur: 0 gir mest mulig like svar fra gang til gang (bra i eksperimentet).
TEMPERATUR=0

# Maks lengde på modellens svar. Uten denne reserverer leverandøren plass til
# et maksimalt svar i minuttkvoten, og på gratisnivået blir forespørselen da
# avvist før den i det hele tatt er sendt. 3000 er rikelig for et svar med steg.
MAKS_SVARTOKENS=2000

# Tidsgrense (sekunder) for ett API-kall, og antall automatiske nye forsøk.
# Gratisnivåene har en tokens-per-minutt-grense, og to kall i samme oppgave kan
# overstige den. Klienten venter da så lenge leverandøren ber om (retry-after)
# og prøver på nytt, i stedet for å gi opp.
API_TIDSGRENSE=180
API_FORSOK=5

# Tidsgrense og minnetak for ett SymPy-verktøykall (kjøres i egen prosess).
VERKTOY_TIDSGRENSE=25
VERKTOY_MINNEGRENSE_MB=2048

# Validering: relativ toleranse, antall punkter og tidsgrense.
VALIDERING_TOLERANSE=1e-8
VALIDERING_PUNKTER=3
VALIDERING_TIDSGRENSE=30

# Kostnadsestimat. Prisene er LISTEPRIS for modellen - gratisnivået koster 0 kr,
# men vi trenger tallene for å kunne svare på "hva ville dette kostet i skala?".
# Standardprisene for Groq-modellene ligger i backend/llm_client.py; her kan
# dere overstyre dem hvis dere bruker en annen leverandør.
# PRIS_INN_USD_PER_MTOK=0.15
# PRIS_UT_USD_PER_MTOK=0.60

# Valutakurs brukt for å vise kroner ved siden av dollar.
# 1 USD = 9,41 NOK (midtkurs 19.09.2026, kilde wise.com).
USD_TIL_NOK=9.41
